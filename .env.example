# Image PlantUML Server (tag Docker Hub plantuml/plantuml-server)
PLANTUML_IMAGE_TAG=jetty

# Réseau Docker externe créé par Traefik
TRAEFIK_NETWORK=traefik-net

# Entrypoint Traefik utilisé pour le routage web interne
TRAEFIK_ENTRYPOINT=web

# Domaine interne (résolu uniquement via le fichier hosts, sur le réseau privé du serveur)
PLANTUML_HOST=plantuml.internal

# Port interne du service Jetty à l'intérieur du conteneur (ne pas changer sauf changement d'image)
PLANTUML_INTERNAL_PORT=8080
